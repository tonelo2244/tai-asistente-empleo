# Copia este archivo como ".env" en la carpeta backend/ y rellena tus propios
# valores. El archivo ".env" nunca debe subirse al repositorio (ver .gitignore).
#
# Si OPENAI_API_KEY no está definida (o el archivo .env no existe), la
# aplicación sigue funcionando con normalidad: todos los análisis usan
# automáticamente el motor basado en reglas ya existente.

# Clave secreta de tu cuenta de OpenAI. Déjala vacía para usar solo reglas.
OPENAI_API_KEY=

# Modelo de OpenAI a utilizar en las llamadas de análisis.
OPENAI_MODEL=gpt-4o-mini
